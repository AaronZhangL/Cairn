# Dependencies
node_modules/

# Build output
apps/desktop/dist/
apps/desktop/build/

# Electrobun toolchain: `electrobun prepare` projects the SDK here, and the
# packager leaves scratch dirs behind. Both are regenerated by `bun run start`.
apps/desktop/.hutch/
apps/desktop/.cottontail-tmp/

# Pipeline cache: per-book map/decks/audio, resumable across runs. Regenerating
# it costs model time, not correctness — it does not belong in history.
.cache/

# Generated books. This is derived content from books the owner already has:
# full chapter text and narration audio. It stays on the machine that made it.
apps/desktop/public/books/
apps/desktop/public/books.json

# Secrets. TAVILY_API_KEY lives in the environment, never in a file here.
.env
.env.*

# macOS
.DS_Store

# Logs
*.log
